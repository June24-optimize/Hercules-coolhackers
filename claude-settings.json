{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(git:*)", "Bash(docker:*)", "Bash(band:*)",
      "Bash(python:*)", "Bash(python3:*)", "Bash(pip:*)", "Bash(pytest:*)",
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)",
      "Bash(curl:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(mkdir:*)", "Bash(cp:*)",
      "Bash(mv:*)", "Bash(rm:*)", "Bash(find:*)", "Bash(grep:*)", "Bash(sed:*)",
      "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(diff:*)", "Bash(sort:*)",
      "Bash(echo:*)", "Bash(test:*)", "Bash(sleep:*)", "Bash(date:*)", "Bash(cd:*)",
      "Bash(. .venv/bin/activate:*)"
    ],
    "deny": [
      "Bash(git push:*)", "Bash(sudo:*)",
      "Read(~/.ssh/**)", "Read(~/.zshrc)", "Read(~/.config/opencode/**)", "Read(**/.env)"
    ]
