{
  "$schema": "https://opencode.ai/config.json",
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 131072,
    "preserve_recent_tokens": 40000
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "read": {
      "*": "allow",
      "*/pocketful/test/*": "deny",
      "*/tablekeeper/test/*": "deny",
      "*/toy/test/*": "deny",
      "*/harness/*.py": "deny",
      "*/.ssh/*": "deny",
      "*/.zshrc": "deny",
      "*/.env": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "sudo *": "deny",
      "* */pocketful/test/*": "deny",
      "* */tablekeeper/test/*": "deny",
      "* */toy/test/*": "deny",
      "* */harness/*.py*": "deny"
    }
  }
}
